APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=120s
HTTP_IDLE_TIMEOUT=60s

# PostgreSQL (GORM)
DATABASE_URL=postgres://pranjalshukla@localhost:5432/mygoapp?sslmode=disable

# Auth (JWT)
JWT_SECRET=dev-only-change-me
JWT_EXPIRY=24h

# Tutor backend: openai | gemini
DEFAULT_CHAT_MODEL=gemini

# Gemini (used when DEFAULT_CHAT_MODEL=gemini)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite

# OpenAI (used when DEFAULT_CHAT_MODEL=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
