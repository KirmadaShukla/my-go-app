                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"maths\",\n  \"language\": \"Hindi\",\n  \"force_new\": true\n}"
            },
            "url": "{{baseUrl}}/tutor/sessions",
            "description": "Always creates a brand-new maths session."
          }
        },
